# ==============================================================================
# CareerCraft AI — Environment Variables Template
# Copy this file to .env for local development and populate with real values.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Flask Server Configuration ---
# Mandatory: 'development' for local, 'production' for deployed environments
FLASK_ENV=production
# Mandatory: Cryptographically random secret key (e.g. python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=replace_with_secure_random_value

# --- Supabase Configuration ---
# Mandatory: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url
# Mandatory: Public anon key (safe for frontend public config)
SUPABASE_ANON_KEY=your_public_supabase_key
# Mandatory (Backend Only): Service role key — NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=backend_only_secret
# Optional (Backend Only): Supabase JWT secret for local HS256 token verification if JWKS is not used
SUPABASE_JWT_SECRET=optional_backend_only_jwt_secret

# --- Google Gemini AI Configuration (Backend Only) ---
# Mandatory (Backend Only): Gemini API key — NEVER expose to the frontend
GEMINI_API_KEY=backend_only_secret
# Mandatory: Configured Gemini model identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=your_configured_gemini_model

# --- Application URLs & CORS ---
# Mandatory: Public URL of the frontend application
FRONTEND_URL=your_frontend_url
# Mandatory: Comma-separated list of allowed CORS origins (no wildcard '*' in production)
ALLOWED_ORIGINS=your_allowed_origins

# --- Technical Safeguards & Limits ---
# Optional (Default: 10): Maximum CV upload size in megabytes
MAX_UPLOAD_SIZE_MB=10
# Optional (Default: 30): Daily AI operation limit per authenticated user
AI_DAILY_REQUEST_LIMIT=your_configured_limit
# Optional (Default: 45): Timeout in seconds for Gemini API requests
AI_REQUEST_TIMEOUT=your_configured_timeout

# --- AI Studio Preview Runtime (Injected automatically in AI Studio) ---
APP_URL="MY_APP_URL"
